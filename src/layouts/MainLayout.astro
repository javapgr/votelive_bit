
---
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />
    <title>{title} | VotaLive</title>
    <script is:inline>
      try {
        const savedTheme = localStorage.getItem("votalive-theme");
        if (savedTheme === "dark" || savedTheme === "light") {
          document.documentElement.dataset.theme = savedTheme;
        }
      } catch {
        // La aplicación conserva el tema predeterminado si el navegador bloquea el almacenamiento.
      }
    </script>
  </head>

  <body>
    <header>
      <nav>
        <a href="/" class="brand">VotaLive</a>

        <div class="links">
          <a href="/docente">Docente</a>
          <a href="/panel">Panel</a>
          <a href="/alumno">Alumno</a>
          <a href="/resultados">Resultados</a>
          <a href="/acceso">Acceso QR</a>
          <button id="themeToggle" class="theme-toggle" type="button" aria-label="Activar modo oscuro">
            Modo oscuro
          </button>
        </div>
      </nav>
    </header>

    <main class="container">
      <slot />
    </main>
  </body>
</html>

<script>
  const themeToggle = document.querySelector<HTMLButtonElement>("#themeToggle");
  const root = document.documentElement;

  function updateThemeButton() {
    const dark = root.dataset.theme === "dark";
    if (themeToggle) {
      themeToggle.textContent = dark ? "Modo claro" : "Modo oscuro";
      themeToggle.setAttribute("aria-label", dark ? "Activar modo claro" : "Activar modo oscuro");
      themeToggle.setAttribute("aria-pressed", String(dark));
    }
  }

  updateThemeButton();
  themeToggle?.addEventListener("click", () => {
    const nextTheme = root.dataset.theme === "dark" ? "light" : "dark";
    root.dataset.theme = nextTheme;
    try {
      localStorage.setItem("votalive-theme", nextTheme);
    } catch {
      // La preferencia solo es opcional y no debe impedir cambiar el tema.
    }
    updateThemeButton();
  });
</script>

<style>
  header {
    background: var(--surface);
    border-bottom: 1px solid #e5e7eb;
  }

  nav {
    max-width: 900px;
    margin: auto;
    padding: 18px 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .brand {
    font-size: 24px;
    font-weight: 800;
    color: #087f74;
  }

  .links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
    font-size: 14px;
  }

  .theme-toggle {
    border: 1px solid #d0d5dd;
    border-radius: 999px;
    padding: 7px 11px;
    color: inherit;
    background: transparent;
    font-size: 13px;
  }
</style>
